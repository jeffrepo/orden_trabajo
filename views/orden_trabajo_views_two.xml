<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="orden_trabajo_form" model="ir.ui.view">
        <field name="name">orden.trabajo.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="orden_trabajo_cortes" string="Cortes" groups="project.group_project_user">
                    <field name="corte_ids">
                        <list string="Líneas" editable="bottom">
                            <field name="company_id" column_invisible="True"/>
                            <field name="lote_id" options="{'no_create': True}"/>
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="corte1"/>
                            <field name="corte2"/>
                            <field name="corte3"/>
                            <field name="corte4"/>
                            <field name="corte5"/>
                            <field name="corte6"/>
                            <field name="total"/>
                            <field name="sobra"/>
                        </list>
                    </field>
                </page>
                <page name="orden_trabajo_molduras" string="Molduras y paneles" groups="project.group_project_user">
                    <field name="moldura_panel_ids">
                        <list string="Líneas" editable="bottom">
                            <field name="company_id" column_invisible="True"/>
                            <field name="product_id"/>
                            <field name="cantidad"/>
                        </list>
                    </field>
                </page>
                <page name="orden_trabajo_accesorios" string="Tornillería y accesorios" groups="project.group_project_user">
                    <field name="tornilleria_accesorio_ids">
                        <list string="Líneas" editable="bottom">
                            <field name="company_id" column_invisible="True"/>
                            <field name="product_id"/>
                            <field name="cantidad"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
