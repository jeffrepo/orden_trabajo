<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_lot_form_orden_trabajo" model="ir.ui.view">
        <field name="name">stock.lot.form.orden.trabajo</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <!-- GDOMEX replaces the main group at priority 16 and already shows largo. -->
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="largo"/>
            </field>
        </field>
    </record>
</odoo>
