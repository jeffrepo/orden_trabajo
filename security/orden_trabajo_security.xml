    </record>
    <record id="corte_manufacturing_rule" model="ir.rule">
        <field name="name">Líneas de órdenes de Fabricación</field>
        <field name="model_id" ref="model_orden_trabajo_corte"/>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
        <field name="domain_force">[('orden_id', '!=', False)]</field>
    </record>
