<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="corte_company_rule" model="ir.rule">
        <field name="name">Órdenes de trabajo: corte por compañía</field>
        <field name="model_id" ref="model_orden_trabajo_corte" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="moldura_panel_company_rule" model="ir.rule">
        <field name="name">Órdenes de trabajo: moldura_panel por compañía</field>
        <field name="model_id" ref="model_orden_trabajo_moldura_panel" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="tornilleria_accesorio_company_rule" model="ir.rule">
        <field name="name">Órdenes de trabajo: tornilleria_accesorio por compañía</field>
        <field name="model_id" ref="model_orden_trabajo_tornilleria_accesorio" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="orden_trabajo_company_rule" model="ir.rule">
        <field name="name">Órdenes de trabajo por compañía</field>
        <field name="model_id" ref="model_orden_trabajo" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="corte_manufacturing_rule" model="ir.rule">
        <field name="name">Líneas de órdenes de Fabricación</field>
        <field name="model_id" ref="model_orden_trabajo_corte" />
        <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]" />
        <field name="domain_force">[('orden_id', '!=', False)]</field>
    </record>
    <record id="moldura_panel_manufacturing_rule" model="ir.rule">
        <field name="name">Líneas de órdenes de Fabricación</field>
        <field name="model_id" ref="model_orden_trabajo_moldura_panel" />
        <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]" />
        <field name="domain_force">[('orden_id', '!=', False)]</field>
    </record>
    <record id="tornilleria_accesorio_manufacturing_rule" model="ir.rule">
        <field name="name">Líneas de órdenes de Fabricación</field>
        <field name="model_id" ref="model_orden_trabajo_tornilleria_accesorio" />
        <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]" />
        <field name="domain_force">[('orden_id', '!=', False)]</field>
    </record>
</odoo>