<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="corte_company_rule" model="ir.rule">
        <field name="name">Órdenes de trabajo: corte por compañía</field>
        <field name="model_id" ref="model_orden_trabajo_corte"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="corte_project_user_rule" model="ir.rule">
        <field name="name">Órdenes de trabajo: corte de proyectos visibles</field>
        <field name="model_id" ref="model_orden_trabajo_corte"/>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="domain_force">['&amp;', ('orden_id', '=', False), '|', ('project_id.privacy_visibility', 'in', ['employees', 'portal']), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="corte_project_manager_rule" model="ir.rule">
        <field name="name">Órdenes de trabajo: corte para administradores de proyectos</field>
        <field name="model_id" ref="model_orden_trabajo_corte"/>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        <field name="domain_force">[('orden_id', '=', False)]</field>
    </record>
